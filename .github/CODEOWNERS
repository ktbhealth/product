# Code owners — changes to these paths require owner review before merge.
#
# NOTE: CODEOWNERS only takes effect when a ruleset/branch-protection rule
# requires code-owner review (see T-057). Direct pushes bypass it entirely —
# pair this file with a ruleset that enforces review on these paths.

# Quality gates — coverage thresholds live here; lowering them must never
# slip through unreviewed.
/vitest.config.ts                @ktbhealth/code-owners
/vitest.*.config.*               @ktbhealth/code-owners
/vitest.workspace.*              @ktbhealth/code-owners
/tools/coverage-report.mjs       @ktbhealth/code-owners

# CI definition — the coverage gate, shard matrix, and required checks are
# defined here; weakening the workflow is equivalent to weakening the gate.
/.github/workflows/               @ktbhealth/code-owners

# Database migrations — schema drift affects every environment; generated
# files, but a bad migration still needs eyes.
/packages/db/alchemy-migrations/  @ktbhealth/code-owners
/packages/db/drizzle/             @ktbhealth/code-owners
