{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"ignoreBinaries": ["cuora"],
	"workspaces": {
		"apps/web": {
			"entry": [
				"alchemy.run.ts",
				"wrangler.jsonc",
				"wrangler.dev.jsonc",
				"src/routes.ts",
				"src/routes/**/*.{ts,tsx}",
				"src/test/**/*.{ts,tsx}",
				// Referenced from package.json scripts (dev:secrets runs
				// `cuora run -- node scripts/dev-secrets.mjs`, which knip's
				// script parser cannot see through the cuora wrapper).
				"scripts/**/*.{ts,mjs}"
			],
			// Resolved by @tailwindcss/vite through @ktbhealth/ui's globals.css.
			// pdfkit is pre-bundled via optimizeDeps.include in vite.config.ts
			// (SSR cold-start fix) — referenced by name, never imported here.
			"ignoreDependencies": ["tailwindcss", "pdfkit"]
		},
		"packages/app-host": {
			// Generated aggregated cipher-spec map (gen:cipher-specs) —
			// exported ahead of its first consumer (the EntityCipher impls
			// that resolve a row's spec at runtime, later ZK tasks).
			"entry": ["src/cipher-specs.gen.ts"]
		},
		"packages/db": {
			"entry": ["scripts/**/*.mjs"]
		},
		"evals/*": {
			// Suite manifests are loaded by file path at runtime
			// (packages/eval-cli scans evals/ recursively) — never
			// statically imported, so knip would flag them as unused.
			// scripts/ are bun-invoked CLI tools (e.g. materialize-ptbr-synthetic).
			"entry": ["*.suite.ts", "scripts/**/*.ts"]
		},
		"packages/eval-adapter-local": {
			// Runnable benchmark harness — `bun scripts/bench/wer.ts`
			// (see scripts/bench/BENCHMARK.md), not imported anywhere.
			"entry": ["scripts/**/*.ts"]
		},
		"infra/oci": {
			// pulumi/ is a standalone Pulumi program — not a workspace
			// member, with its own package.json/lockfile; its @pulumi/*
			// deps are intentionally not declared on @ktb/infra-oci.
			"ignore": ["pulumi/**"]
		},
		"infra/oci": {
			// pulumi/ is a standalone Pulumi program — not a workspace
			// member, with its own package.json/lockfile; its @pulumi/*
			// deps are intentionally not declared on @ktb/infra-oci.
			"ignore": ["pulumi/**"]
		},
		"plugins/groups": {
			// No static source import remains after the @ktb/views/table
			// migration, but tests vi.mock("@tanstack/react-router") for
			// the kit's useServerMutation — the dep must stay resolvable.
			"ignoreDependencies": ["@tanstack/react-router"]
		},
		"plugins/rbac": {
			// Same as plugins/groups — kept for test-time vi.mock of the
			// kit's router usage.
			"ignoreDependencies": ["@tanstack/react-router"]
		},
		"plugins/notifications": {
			// Only referenced by generated src/route-types.d.ts
			// (`import type {} from "@tanstack/react-start"` / `AnyRoute`
			// from "@tanstack/react-router"`) and a
			// vi.mock("@tanstack/react-start/server") factory — no static
			// import for knip to count.
			"ignoreDependencies": []
		},
		"plugins/theme": {
			// hb-subset/patch-wasm.mjs is a provenance script — run by
			// hand (`bun hb-subset/patch-wasm.mjs`) to reproduce the
			// vendored src/hb-subset.wasm byte-identically; never
			// imported by app code.
			"entry": ["hb-subset/*.mjs"]
		}
	}
}
